{
  "name": "ethio-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "bash scripts/db-test.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:types": "npx supabase gen types typescript --schema public > /tmp/db-types.ts && test -s /tmp/db-types.ts && grep -q 'Tables' /tmp/db-types.ts && mv /tmp/db-types.ts src/lib/supabase/database.types.ts || (echo 'db:types failed: is local Supabase running?' && exit 1)",
    "dev:sample-images": "node --env-file=.env.local scripts/dev-sample-images.mjs",
    "test:smoke": "node --env-file=.env.local tests/e2e/storefront.smoke.cjs",
    "test:smoke:checkout": "node --env-file=.env.local tests/e2e/checkout.smoke.cjs",
    "dev:up": "bash scripts/dev-up.sh",
