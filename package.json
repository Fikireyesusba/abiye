{
  "name": "ethio-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "bash scripts/db-test.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:types": "npx supabase gen types typescript --schema public > src/lib/supabase/database.types.ts",
    "dev:sample-images": "node --env-file=.env.local scripts/dev-sample-images.mjs",
    "test:smoke": "node --env-file=.env.local tests/e2e/storefront.smoke.cjs",
    "test:smoke:checkout": "node --env-file=.env.local tests/e2e/checkout.smoke.cjs",
    "dev:up": "bash scripts/dev-up.sh",
    "admin:create": "node --env-file=.env.local scripts/create-super-admin.mjs",
    "test:smoke:admin": "node --env-file=.env.local tests/e2e/admin.smoke.cjs",
    "test:smoke:printing": "node --env-file=.env.local tests/e2e/printing.smoke.cjs",
    "test:smoke:telegram": "node --env-file=.env.local tests/e2e/telegram.smoke.cjs",
    "test:smoke:account": "node --env-file=.env.local tests/e2e/account.smoke.cjs",
    "test:smoke:customers": "node --env-file=.env.local tests/e2e/customer-admin.smoke.cjs",
    "db:bundle": "node scripts/build-production-sql.mjs",
    "test:db:bundle": "BUNDLE=1 bash scripts/db-test.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.38.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
