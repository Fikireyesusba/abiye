# =============================================================================
# Environment template. Copy to .env.local for development.
# NEVER commit real values. In production, set these in Vercel → Settings →
# Environment Variables.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Browser-safe publishable key (sb_publishable_...). Legacy "anon" key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER-ONLY secret key (sb_secret_...). Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Legacy "service_role" key also works via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Application ------------------------------------------------------------
# Public base URL (used in Telegram links). Production: https://yourshop.com
APP_URL=http://localhost:3000
# Shared secret for Vercel Cron → /api/cron/* (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- Telegram staff alerts --------------------------------------------------
# Create a bot with @BotFather; get the private group id (see docs/DEPLOYMENT.md §4).
# Leave empty to keep alerts queued (nothing is lost) until configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
