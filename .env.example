# =============================================================================
# Environment template. Copy to .env.local for development.
# NEVER commit real values. In production, set these in Vercel → Settings →
# Environment Variables.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Browser-safe publishable key (sb_publishable_...). Legacy "anon" key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER-ONLY secret key (sb_secret_...). Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Legacy "service_role" key also works via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Application ------------------------------------------------------------
# Public base URL (used in Telegram links). Production: https://yourshop.com
APP_URL=http://localhost:3000
# Shared secret for Vercel Cron → /api/cron/* (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- Telegram staff alerts --------------------------------------------------
# Create a bot with @BotFather; get the private group id (see docs/DEPLOYMENT.md §4).
# Leave empty to keep alerts queued (nothing is lost) until configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Virus scan of every file customers upload (payment / top-up receipts, printing documents) — Cloudmersive.
# REQUIRED for customer uploads: without it every upload is refused (the site fails closed).
# Create the key at https://account.cloudmersive.com (API Keys). Mark it Sensitive in Vercel.
CLOUDMERSIVE_API_KEY=

# Customer emails (order placed, payment verified/rejected, ready, shipped, …) via the Resend API.
# Leave empty to disable. Create a key in Resend → API Keys ("Sending access", your domain).
RESEND_API_KEY=
# Sender shown to customers; the domain must be verified in Resend.
EMAIL_FROM="Abiye <orders@yourdomain.com>"

# Customer phone notifications (Web Push). Create the keys in Admin → Notifications
# ("Create notification keys" — generated in your browser), then paste them here / in Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@yourdomain.com
